# Copy this file to .env. Never commit the resulting .env file.

# Which provider generates answers: google or openrouter.
# Leave blank to auto-detect from whichever API key below is set. When both are
# set, Google is used. When neither is set, IslamAI asks for an OpenRouter key.
# Both keys can safely coexist here; switching providers does not erase either.
ISLAMAI_LLM_PROVIDER=

# --- Google Gemini ---
# Required for generated answers. If blank, IslamAI requests it in the UI.
GOOGLE_API_KEY=

# Stable default generation model.
GEMINI_MODEL=gemini-3.1-flash-lite

# --- OpenRouter (also reaches OpenAI and any OpenAI-compatible host) ---
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# The model MUST support tool calling. IslamAI answers by calling Quran and
# Hadith search tools, so a model without tool support cannot cite sources and
# is rejected when the key is validated. Free model availability rotates; list
# current tool-capable free models with:
#   curl -s https://openrouter.ai/api/v1/models \
#     | jq -r '.data[] | select(.id|endswith(":free"))
#              | select(.supported_parameters|index("tools")) | .id'
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Optional: any OpenAI-compatible endpoint. Point this at
# https://api.openai.com/v1 to use OpenAI directly. Must be HTTPS.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional: HTTPS endpoint for a versioned corpus release manifest.
# Update checks remain disabled when this is unset.
# ISLAMAI_CORPUS_MANIFEST_URL=https://updates.example.invalid/islamai/corpus-manifest.json

# CHAINLIT_AUTH_SECRET is intentionally omitted. IslamAI generates it locally.
